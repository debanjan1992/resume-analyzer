{
  "functions": [
    {
      "source": "dist/apps/api",
      "codebase": "default",
      "runtime": "nodejs24",
      "disallowLegacyRuntimeConfig": false,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist/apps/resume-analyzer/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "singleProjectMode": true,
    "ui": {
      "enabled": true,
      "port": 8008
    }
  }
}
